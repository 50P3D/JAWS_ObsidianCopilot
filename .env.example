# Copy this file to .env and fill in what you need. Never commit .env (it is in .gitignore).
# Nothing loads .env by itself. Run scripts with Node's flag, for example:
#   npx tsx --env-file=.env src/crosscheck/smoke.ts
# Every value below is optional. The defaults shown are what the code uses when a variable is unset.

# ── Local models (Ollama) ──────────────────────────────────────────
# Where Ollama is running.
OLLAMA_URL=http://localhost:11434
# Model for claim extraction and verdicts.
OLLAMA_MODEL=qwen3.5:4b
# Model for retrieval embeddings (run: ollama pull nomic-embed-text).
EMBED_MODEL=nomic-embed-text

# ── Wikimedia ──────────────────────────────────────────────────────
# Wikimedia asks every client to say who it is. Use your email or the repo URL.
NOTECHECK_CONTACT=
# Set to off to skip the Lift Wing revert-risk signal in the reliability badge.
NOTECHECK_LIFTWING=on

# ── Course materials (MCP server and course smoke test) ────────────
# Folder of markdown files to use as course evidence. Leave empty for none.
NOTECHECK_COURSE_DIR=

# ── Claude cross-check live test only ──────────────────────────────
# Used by `npm run smoke:crosscheck`. The plugin itself takes the key in its settings, not from here.
ANTHROPIC_API_KEY=
